# Copy to .env.local for local dev. On Vercel, set these in Project Settings > Environment Variables.

# Public URL of the site, used for metadata, sitemap and calendar links.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres. On Vercel, add the Neon integration and it sets this for you.
# Leave empty locally to use an embedded database stored in ./.data
DATABASE_URL=

# Owner dashboard (/admin). Use a long password, and a random secret of 32+ chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
SESSION_SECRET=

# Google Calendar sync (optional). See README > Google Calendar.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service account JSON, keeping the \n sequences.
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
# When true, busy times in that calendar also block booking slots.
GOOGLE_CALENDAR_BLOCKS_AVAILABILITY=true
